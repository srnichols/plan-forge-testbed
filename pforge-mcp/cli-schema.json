            "planned",
            "in-progress",
            "complete",
            "paused"
          ]
        }
      ],
      "flags": {},
      "examples": [
        "pforge phase-status docs/plans/Phase-1.md complete"
      ],
      "note": "CLI-only — not available as MCP tool."
    },
    "diff": {
      "description": "Compare changes against plan's Scope Contract",
      "args": [
        {
          "name": "plan",
          "type": "path",
          "required": true
