<?xml version="1.0" encoding="utf-8"?>
<!-- Reproducible restores: ignore machine-wide package sources and Visual Studio
     fallback folders (a stale one breaks restore with NU1301) and use nuget.org only. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
