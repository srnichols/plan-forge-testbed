# Normalize line endings to prevent CRLF/LF churn across platforms.
# Text files are stored as LF in the repository; checkout converts as needed.
* text=auto eol=lf

# Windows-only scripts use CRLF in the working tree
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Scripts that MUST stay LF (executed on Unix / in containers)
*.sh        text eol=lf
pforge      text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf

# Common source / config files (explicit for clarity)
*.mjs    text eol=lf
*.js     text eol=lf
*.cs     text eol=lf
*.json   text eol=lf
*.jsonl  text eol=lf
*.md     text eol=lf
*.toml   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.razor  text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.graphql text eol=lf
*.http   text eol=lf
*.py     text eol=lf

# Binary assets — never normalize
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.dll   binary
*.exe   binary
*.snk   binary
