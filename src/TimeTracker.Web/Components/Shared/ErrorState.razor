<FluentMessageBar Intent="MessageIntent.Error" Title="@Message">
    @Detail
</FluentMessageBar>
@if (OnRetry.HasDelegate)
{
    <FluentButton Appearance="Appearance.Accent" OnClick="OnRetry">Retry</FluentButton>
}

@code {
    [Parameter, EditorRequired] public string Message { get; set; } = default!;
    [Parameter] public string? Detail { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
}
