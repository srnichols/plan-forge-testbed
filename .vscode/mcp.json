{
  "servers": {
    "plan-forge": {
      "args": [
        "pforge-mcp/server.mjs"
      ],
      "type": "stdio",
      "cwd": "${workspaceFolder}",
      "command": "node"
    },
    "openbrain": {
      "type": "sse",
      "url": "https://openbrain.tailfb4202.ts.net/sse",
      "headers": {
        "x-brain-key": "${env:OPENBRAIN_KEY}"
      }
    }
  }
}
